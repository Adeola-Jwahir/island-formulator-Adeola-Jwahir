<div class="w-full">
  <div class="flex justify-between items-center mb-8">
    <h1 class="font-bold text-4xl text-gray-900">Welcome to Your Dashboard</h1>
    <div class="text-sm text-gray-500">
      <%= Time.now.strftime("%A, %B %d, %Y") %>
    </div>
  </div>

  <!-- Stats Grid with Gold borders and Pink links -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 my-8">
    <div class="bg-white p-6 rounded-lg shadow border-t-4 border-amber-500 hover:shadow-lg transition-shadow">
      <p class="text-gray-500 uppercase text-xs font-bold">Ingredients</p>
      <p class="text-3xl font-bold text-gray-900"><%= @stats[:ingredients] %></p>
      <%= link_to "View all →", ingredients_path, class: "text-xs text-pink-600 hover:text-amber-600 mt-2 block" %>
    </div>
    <div class="bg-white p-6 rounded-lg shadow border-t-4 border-amber-600 hover:shadow-lg transition-shadow">
      <p class="text-gray-500 uppercase text-xs font-bold">Recipes</p>
      <p class="text-3xl font-bold text-gray-900"><%= @stats[:recipes] %></p>
      <%= link_to "View all →", recipes_path, class: "text-xs text-pink-600 hover:text-amber-600 mt-2 block" %>
    </div>
    <div class="bg-white p-6 rounded-lg shadow border-t-4 border-amber-500 hover:shadow-lg transition-shadow">
      <p class="text-gray-500 uppercase text-xs font-bold">Inventory Items</p>
      <p class="text-3xl font-bold text-gray-900"><%= @stats[:inventory] %></p>
      <%= link_to "View all →", inventory_items_path, class: "text-xs text-pink-600 hover:text-amber-600 mt-2 block" %>
    </div>
    <div class="bg-white p-6 rounded-lg shadow border-t-4 border-amber-600 hover:shadow-lg transition-shadow">
      <p class="text-gray-500 uppercase text-xs font-bold">Total Batches</p>
      <p class="text-3xl font-bold text-gray-900"><%= @stats[:batches] %></p>
      <%= link_to "View all →", batches_path, class: "text-xs text-pink-600 hover:text-amber-600 mt-2 block" %>
    </div>
  </div>

  <div class="flex flex-col md:flex-row gap-8">
    <!-- Recent Recipes -->
    <div class="flex-1">
      <div class="flex justify-between items-center mb-4">
        <h2 class="font-bold text-2xl text-gray-900">Recent Recipes</h2>
        <%= link_to "New Recipe", new_recipe_path, class: "text-sm bg-pink-50 text-pink-600 px-3 py-1 rounded-full hover:bg-amber-100 hover:text-amber-700 transition-colors" %>
      </div>
      <div class="bg-white shadow rounded-lg divide-y divide-gray-100">
        <% @recent_recipes.each do |recipe| %>
          <div class="p-4 flex justify-between items-center hover:bg-pink-50 transition-colors">
            <div>
              <%= link_to recipe.title, recipe, class: "text-pink-600 hover:text-amber-600 font-medium" %>
              <p class="text-xs text-gray-400"><%= recipe.product_type %></p>
            </div>
            <span class="text-sm text-gray-500"><%= recipe.created_at.strftime("%b %d") %></span>
          </div>
        <% end %>
        <% if @recent_recipes.empty? %>
          <div class="p-8 text-center">
            <p class="text-gray-500 mb-4">No recipes yet.</p>
            <%= link_to "Create your first recipe", new_recipe_path, class: "text-pink-600 hover:text-amber-600 font-medium" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Recent Batches -->
    <div class="flex-1">
      <div class="flex justify-between items-center mb-4">
        <h2 class="font-bold text-2xl text-gray-900">Recent Batches</h2>
        <%= link_to "Log Batch", new_batch_path, class: "text-sm bg-amber-50 text-amber-600 px-3 py-1 rounded-full hover:bg-pink-100 hover:text-pink-700 transition-colors" %>
      </div>
      <div class="bg-white shadow rounded-lg divide-y divide-gray-100">
        <% @recent_batches.each do |batch| %>
          <div class="p-4 flex justify-between items-center hover:bg-amber-50 transition-colors">
            <div>
              <p class="font-medium text-gray-900"><%= batch.recipe.title %></p>
              <p class="text-xs text-gray-500 italic"><%= batch.notes.truncate(40) if batch.notes.present? %></p>
            </div>
            <div class="text-right">
              <span class="text-sm text-gray-500 block"><%= batch.made_on.strftime("%b %d") %></span>
              <%= link_to "Details", batch, class: "text-xs text-pink-600 hover:text-amber-600" %>
            </div>
          </div>
        <% end %>
        <% if @recent_batches.empty? %>
          <div class="p-8 text-center">
            <p class="text-gray-500 mb-4">No batches logged yet.</p>
            <%= link_to "Log your first batch", new_batch_path, class: "text-amber-600 hover:text-pink-600 font-medium" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="mt-12 bg-linear-to-r from-pink-50 to-amber-50 p-8 rounded-2xl border-2 border-dashed border-amber-200">
    <h2 class="font-bold text-xl mb-6 text-center text-gray-800">Quick Actions</h2>
    <div class="flex flex-wrap justify-center gap-4">
      <%= link_to "Add New Ingredient", new_ingredient_path, class: "bg-white border border-gray-200 px-6 py-3 rounded-xl shadow-sm hover:shadow-md transition-all font-medium text-gray-700 hover:border-pink-300 hover:text-pink-600" %>
      <%= link_to "Record Purchase", new_inventory_item_path, class: "bg-white border border-gray-200 px-6 py-3 rounded-xl shadow-sm hover:shadow-md transition-all font-medium text-gray-700 hover:border-amber-300 hover:text-amber-600" %>
      <%= link_to "Create Recipe", new_recipe_path, class: "bg-white border border-gray-200 px-6 py-3 rounded-xl shadow-sm hover:shadow-md transition-all font-medium text-gray-700 hover:border-pink-300 hover:text-pink-600" %>
      <%= link_to "Log Production", new_batch_path, class: "bg-white border border-gray-200 px-6 py-3 rounded-xl shadow-sm hover:shadow-md transition-all font-medium text-gray-700 hover:border-amber-300 hover:text-amber-600" %>
    </div>
  </div>
</div>