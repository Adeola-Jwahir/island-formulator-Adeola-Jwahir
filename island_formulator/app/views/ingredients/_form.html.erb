<%= form_with(model: ingredient, class: "space-y-6") do |form| %>

  <% if ingredient.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
      <h2 class="font-bold mb-2">
        <%= pluralize(ingredient.errors.count, "error") %> prevented this ingredient from being saved:
      </h2>

      <ul class="list-disc pl-5">
        <% ingredient.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow p-6 rounded-lg border-t-4 border-amber-500">
    <%= form.label :photo, "Ingredient Photo", class: "block font-bold text-gray-700 mb-2" %>
    <div class="flex items-center justify-center w-full">
      <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:border-pink-500 hover:bg-pink-50 transition-colors">
        <div class="flex flex-col items-center justify-center pt-5 pb-6">
          <svg class="w-8 h-8 mb-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"/>
          </svg>
          <p class="mb-2 text-sm text-gray-500"><span class="font-semibold">Click to upload</span> or drag and drop</p>
          <p class="text-xs text-gray-500">PNG, JPG or GIF</p>
        </div>
        <%= form.file_field :photo, accept: "image/*", class: "hidden" %>
      </label>
    </div>
    <% if ingredient.photo.attached? %>
      <p class="mt-2 text-sm text-amber-600">✓ Current photo: <%= ingredient.photo.filename %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_field :name,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :category, class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_field :category,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_area :description, rows: 4,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500 px-3 py-2" %>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_area :notes, rows: 3,
        class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-pink-500 focus:ring-pink-500 px-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= form.label :tag_ids, "Benefits & Properties", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <div class="grid grid-cols-2 gap-2">
      <%= form.collection_check_boxes :tag_ids, Tag.all, :id, :name do |cb| %>
        <div class="flex items-center">
          <%= cb.check_box class: "w-4 h-4 text-pink-600 border-gray-300 rounded focus:ring-pink-500" %>
          <%= cb.label class: "ml-2 text-sm text-gray-700" %>
        </div>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.submit class: "w-full sm:w-auto rounded-md px-5 py-3 bg-gradient-to-r from-pink-600 to-amber-600 hover:from-pink-700 hover:to-amber-700 text-white font-semibold shadow-md transition duration-200 cursor-pointer" %>
  </div>

<% end %>