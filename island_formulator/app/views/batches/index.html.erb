<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-amber-50 text-amber-600 font-medium rounded-lg inline-block mb-5" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl text-gray-900">Batch History</h1>
    <%= link_to "Log New Batch", new_batch_path, class: "rounded-lg py-3 px-5 bg-gradient-to-r from-pink-600 to-amber-600 hover:from-pink-700 hover:to-amber-700 text-white block font-medium" %>
  </div>

  <div id="batches" class="min-w-full mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
    <% @batches.each do |batch| %>
      <div class="bg-white shadow rounded-lg p-6 border-l-4 border-amber-500 hover:shadow-lg transition-shadow">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="font-bold text-xl text-gray-900"><%= batch.recipe.title %></h2>
            <p class="text-sm text-gray-500"><%= batch.made_on.strftime("%B %d, %Y") %></p>
          </div>
          <%= link_to "View Details", batch, class: "text-sm text-pink-600 hover:text-amber-600" %>
        </div>
        
        <% if batch.notes.present? %>
          <div class="mt-4 text-gray-600 italic text-sm bg-pink-50 p-3 rounded-lg">
            "<%= batch.notes.truncate(100) %>"
          </div>
        <% end %>
      </div>
    <% end %>
    
    <% if @batches.empty? %>
      <div class="col-span-2 text-center py-12 bg-white rounded-lg shadow border-t-4 border-amber-500">
        <p class="text-gray-500 mb-4">No batches logged yet. Go make something!</p>
        <%= link_to "Log Your First Batch", new_batch_path, class: "text-pink-600 font-semibold hover:text-amber-600" %>
      </div>
    <% end %>
  </div>
</div>